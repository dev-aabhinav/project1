# Copy this file to `.env` and fill in real values.
# .env is gitignored; this file is committed so others know which variables exist.

# Port the HTTP server listens on
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string (REQUIRED). Local: mongodb://127.0.0.1:27017/huddle
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/huddle
MONGODB_URI=mongodb://127.0.0.1:27017/huddle

# Secret that signs login tokens (REQUIRED, >= 32 chars). The value below is for LOCAL DEV ONLY;
# the app refuses to start with it when NODE_ENV=production. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# How long a login token stays valid: 15m, 12h, 1d ...
JWT_EXPIRES_IN=1d

# bcrypt cost factor (each +1 doubles hashing time). Default 11; minimum 10 in production.
BCRYPT_ROUNDS=11
